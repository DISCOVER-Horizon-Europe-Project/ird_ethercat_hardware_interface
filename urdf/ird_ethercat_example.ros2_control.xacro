<?xml version="1.0"?>
<!--
  Example <ros2_control> block for ird_ethercat_hardware_interface.
  Include it from your robot's URDF/xacro and call the macro, e.g.:

    <xacro:include filename="$(find ird_ethercat_hardware_interface)/urdf/ird_ethercat_example.ros2_control.xacro"/>
    <xacro:ird_ethercat_example name="drives"
        config_file="$(find my_robot)/config/drives.yaml" ethercat_interface="eno1"/>

  Everything about the drives (bus timing, PDO mapping, units, limits, fault
  handling) is in the YAML configuration file. The URDF only has to:
    - name the configuration file,
    - declare one <joint> per drive, with the names used in the file, each with
      a `velocity` command interface and `position` + `velocity` state
      interfaces (in that order).
  The joints must also exist as <joint> elements of the robot model.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ird_ethercat_example" params="name config_file ethercat_interface:=''">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>ird_ethercat_hardware_interface/IrdEthercatSystem</plugin>
        <!-- YAML configuration file (see config/ird_csv_example.yaml). -->
        <param name="config_file">${config_file}</param>
        <!-- Optional: overrides bus.interface of the configuration file, e.g.
             to choose the network interface from a launch argument. -->
        <param name="ethercat_interface">${ethercat_interface}</param>
      </hardware>

      <joint name="drivewhl_l_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="drivewhl_r_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="turret_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
